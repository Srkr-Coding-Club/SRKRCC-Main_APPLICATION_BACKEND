# ==========================================
# SRKR Coding Club Backend: Production Configuration
# Email goes out through Gmail SMTP (EMAIL_PROVIDER=gmail)
# Every variable is documented in .env.example. Set these in your host's
# environment settings; nothing here depends on a particular platform.
# ==========================================

# Core Django Settings
DEBUG=False
# Generate a strong 50+ character random secret key:
SECRET_KEY=generate-a-strong-random-secret-key-here-for-production
# Hostnames this backend serves, comma separated (no scheme).
ALLOWED_HOSTS=api.srkrcc.in
# Optional: hostnames your hosting platform assigns (a leading dot matches subdomains),
# e.g. .example-host.com. Counts as an allowed-hosts list.
PLATFORM_HOSTS=

# Database Configuration (any PostgreSQL connection URL)
DATABASE_URL=postgres://user:password@db.example.com:5432/dbname?sslmode=require

# CORS & CSRF Settings (the frontend origin(s), no trailing slash)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://srkrcc.in,https://www.srkrcc.in
CSRF_TRUSTED_ORIGINS=https://srkrcc.in,https://www.srkrcc.in,https://api.srkrcc.in

# Public address of the frontend. Every link inside an email (password setup,
# form confirmations, hackathon invites) is built from this.
FRONTEND_URL=https://srkrcc.in

# HTTPS and proxies
# True only if nothing in front of the app already redirects to HTTPS.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
# Add 1 for each extra proxy or CDN in front of the app.
TRUSTED_PROXY_COUNT=1
# Random string; set the same value in the frontend's CLIENT_IP_SHARED_SECRET.
CLIENT_IP_SHARED_SECRET=

# Automated Super Admin Provisioning (used during deployment)
DJANGO_SUPERUSER_EMAIL=admin@srkr.ac.in
DJANGO_SUPERUSER_PASSWORD=ChangeThisStrongAdminPassword@2025
DJANGO_SUPERUSER_USERNAME=admin

# JWT Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Logging and error tracking (Sentry is on only when SENTRY_DSN is set)
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# ------------------------------------------
# Email: Gmail SMTP
# ------------------------------------------
EMAIL_PROVIDER=gmail
# The Gmail account that sends the mail. Turn on 2-Step Verification, then create an
# app password at https://myaccount.google.com/apppasswords (the normal password will not work).
EMAIL_HOST_USER=srkrcodingclub@gmail.com
# Google shows the app password in four groups; it works with or without the spaces.
EMAIL_HOST_PASSWORD=your-google-app-password
# Gmail rewrites the From address to EMAIL_HOST_USER unless the sender is a verified
# "Send mail as" alias, so keep the two the same unless you have set up an alias.
DEFAULT_FROM_EMAIL=SRKR Coding Club <srkrcodingclub@gmail.com>
# Gmail caps sending at about 500 recipients per day on a free account (2,000 on Google Workspace).
# Gmail uses SMTP port 587; some hosts block outbound SMTP, so confirm yours allows it.
