# ==========================================
# SRKR Coding Club Backend — Production Configuration
# ==========================================

# Core Django Settings
DEBUG=False
# Generate a strong 50+ character random secret key:
SECRET_KEY=generate-a-strong-random-secret-key-here-for-production
ALLOWED_HOSTS=your-backend.onrender.com,api.srkrcc.in,localhost,127.0.0.1

# Database Configuration (PostgreSQL URL from Neon, Supabase, or Render)
DATABASE_URL=postgres://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS & CSRF Settings (Allow your frontend domain)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://srkrcc.vercel.app,https://srkrcc.in
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com,https://srkrcc.vercel.app

# Automated Super Admin Provisioning (Used during deployment)
DJANGO_SUPERUSER_EMAIL=admin@srkr.ac.in
DJANGO_SUPERUSER_PASSWORD=ChangeThisStrongAdminPassword@2025
DJANGO_SUPERUSER_USERNAME=admin

# JWT Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Notification Backend (Optional: Gmail SMTP or Resend/SendGrid)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=srkrcodingclub@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=SRKR Coding Club <noreply@srkrcc.in>
