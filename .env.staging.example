# ==========================================
# SRKR Coding Club Backend: Staging Configuration
# Email goes out through Resend (EMAIL_PROVIDER=resend)
# Every variable is documented in .env.example. Set these in your host's
# environment settings; nothing here depends on a particular platform.
# ==========================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-staging
# Hostnames this backend serves, comma separated (no scheme).
ALLOWED_HOSTS=api-staging.example.com
# Optional: hostnames your hosting platform assigns (a leading dot matches subdomains),
# e.g. .example-host.com. Counts as an allowed-hosts list.
PLATFORM_HOSTS=

# Database Configuration (use a separate database from production)
DATABASE_URL=postgres://user:password@staging-db.example.com:5432/dbname?sslmode=require

# CORS & CSRF Settings (the staging frontend origin, no trailing slash)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app-staging.example.com
CSRF_TRUSTED_ORIGINS=https://api-staging.example.com,https://app-staging.example.com

# Public address of the staging frontend. Every link inside an email is built from this.
FRONTEND_URL=https://app-staging.example.com

# HSTS: keep it short on staging so a mistake cannot lock browsers into HTTPS for a year.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Paths your platform polls for health; answered whatever Host header it sends.
HEALTH_CHECK_PATHS=/,/api/ping,/api/ping/

# API rate limits per client IP (<count>/<second|minute|hour|day>); see .env.example.
THROTTLE_ANON=100/minute
THROTTLE_USER=1000/minute
THROTTLE_LOGIN=10/minute
THROTTLE_REGISTER=10/hour
THROTTLE_FORM_SUBMIT=20/minute
THROTTLE_HACKATHON_LOOKUP=30/minute
THROTTLE_HACKATHON_EMAIL_INVITE=20/hour
THROTTLE_COLLEGE_SEARCH=120/minute

# Proxies and rate limiting
TRUSTED_PROXY_COUNT=1
# Same random value as the frontend's CLIENT_IP_SHARED_SECRET.
CLIENT_IP_SHARED_SECRET=

# Automated Super Admin Provisioning (used during deployment)
DJANGO_SUPERUSER_EMAIL=admin@srkr.ac.in
DJANGO_SUPERUSER_PASSWORD=ChangeThisStagingAdminPassword@2025
DJANGO_SUPERUSER_USERNAME=admin

# JWT Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Logging and error tracking (Sentry is on only when SENTRY_DSN is set)
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0

# ------------------------------------------
# Email: Resend (HTTPS API, so it also works where SMTP ports are blocked)
# ------------------------------------------
EMAIL_PROVIDER=resend
# Create the key at https://resend.com/api-keys (starts with re_).
RESEND_API_KEY=re_your_resend_api_key
# Until you verify a domain at https://resend.com/domains, use the sandbox sender below.
# The sandbox sender can only deliver to the email address that owns the Resend account,
# so to email other testers verify a domain and switch to e.g. noreply@mail.srkrcc.in.
# Resend rejects free-mailbox senders such as @gmail.com.
DEFAULT_FROM_EMAIL=SRKR Coding Club <onboarding@resend.dev>
