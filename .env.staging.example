# ==========================================
# SRKR Coding Club Backend: Staging Configuration
# Email goes out through Resend (EMAIL_PROVIDER=resend)
# ==========================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-staging
ALLOWED_HOSTS=.onrender.com,0.0.0.0,localhost,127.0.0.1

# Database Configuration (use a separate database from production)
DATABASE_URL=postgres://user:password@ep-staging-db.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS & CSRF Settings (the staging frontend, no trailing slash)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-staging-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-staging-backend.onrender.com,https://your-staging-frontend.vercel.app

# Public address of the staging frontend. Every link inside an email is built from this.
FRONTEND_URL=https://your-staging-frontend.vercel.app

# Automated Super Admin Provisioning (Used during deployment)
DJANGO_SUPERUSER_EMAIL=admin@srkr.ac.in
DJANGO_SUPERUSER_PASSWORD=ChangeThisStagingAdminPassword@2025
DJANGO_SUPERUSER_USERNAME=admin

# JWT Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------
# Email: Resend (HTTPS API, so it also works where SMTP ports are blocked)
# ------------------------------------------
EMAIL_PROVIDER=resend
# Create the key at https://resend.com/api-keys (starts with re_).
RESEND_API_KEY=re_your_resend_api_key
# Until you verify a domain at https://resend.com/domains, use the sandbox sender below.
# The sandbox sender can only deliver to the email address that owns the Resend account,
# so to email other testers verify a domain and switch to e.g. noreply@mail.srkrcc.in.
# Resend rejects free-mailbox senders such as @gmail.com.
DEFAULT_FROM_EMAIL=SRKR Coding Club <onboarding@resend.dev>
