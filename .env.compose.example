# Copy to .env next to docker-compose.yml and fill in. Never commit the real file.
POSTGRES_PASSWORD=
SECRET_KEY=
DJANGO_SUPERUSER_PASSWORD=
# Defaults to DEBUG=True (a local stack). For a production-like run set DEBUG=False and
# ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS, plus a public FRONTEND_URL so
# email links work. See .env.example for every variable.
# DEBUG=True
# FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
