# Copy to .env next to docker-compose.yml and fill in. Never commit the real file.
POSTGRES_PASSWORD=
SECRET_KEY=
DJANGO_SUPERUSER_PASSWORD=
# Defaults to DEBUG=True (a local stack). For a production-like run set DEBUG=False and a
# public FRONTEND_URL / CORS_ALLOWED_ORIGINS -- the backend refuses to start otherwise.
# DEBUG=True
# FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
