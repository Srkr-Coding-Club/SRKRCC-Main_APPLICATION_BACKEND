DEBUG=True
SECRET_KEY=django-insecure-srkrcc-dev-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Required in production (DEBUG=False): comma-separated origins allowed to submit
# cross-origin POSTs with CSRF cookies, e.g. https://srkrcc.in,https://www.srkrcc.in
CSRF_TRUSTED_ORIGINS=
# Set to False only if TLS termination happens somewhere that already redirects to HTTPS
SECURE_SSL_REDIRECT=True

# PostgreSQL Connection String
DATABASE_URL=postgres://postgres:postgres@localhost:5432/srkrcc_db

# JWT Token Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# File Storage (Cloudflare R2 / S3)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STORAGE_BUCKET_NAME=
R2_S3_CUSTOM_DOMAIN=
