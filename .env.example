# ==========================================================================
# SRKR Coding Club Backend: environment reference
#
# This file lists every variable the backend reads. Copy it to `.env` for local
# development. For deployments see .env.staging.example and .env.production.example.
# Nothing here is tied to one hosting platform: moving hosts means changing values,
# not code.
#
# Blank values fall back to the default noted next to each key. Never commit `.env`.
# ==========================================================================

# ------------------------------------------
# Core
# ------------------------------------------
DEBUG=True
# Production needs a unique value of 50+ random characters. The development value below is
# rejected when DEBUG=False.
SECRET_KEY=django-insecure-srkrcc-dev-secret-key-change-in-prod
# Hostnames this backend serves, comma separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1
# Hostnames your hosting platform assigns to the service, comma separated; a leading dot
# matches every subdomain (e.g. .example-host.com). Counts as an allowed-hosts list.
PLATFORM_HOSTS=
# Public address of the frontend. Every link inside an email (password setup, reset, form
# confirmations, hackathon invites) is built from it. Unset means http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# CORS / CSRF
# ------------------------------------------
# Origins allowed to call the API (no trailing slash). Defaults to localhost when DEBUG=True.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins allowed to submit cross-origin POSTs with CSRF cookies. Required when DEBUG=False.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Defaults to True when DEBUG=True and False otherwise. Refused when DEBUG=False.
CORS_ALLOW_ALL_ORIGINS=
# Defaults to True when DEBUG=True and False otherwise.
CORS_ALLOW_CREDENTIALS=

# ------------------------------------------
# HTTPS and proxies (used when DEBUG=False)
# ------------------------------------------
# Set to True only if nothing in front of the app already redirects to HTTPS.
SECURE_SSL_REDIRECT=False
# HSTS makes browsers refuse plain HTTP for this site for that many seconds, and they cannot be
# told to forget it early. Use a short value (e.g. 3600) until the deployment is settled, then
# raise it to 31536000 (one year). 0 turns the header off.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
# Paths your hosting platform polls to check the app is alive, comma separated. They answer
# whatever Host header the platform sends and are never redirected to HTTPS.
HEALTH_CHECK_PATHS=/,/api/ping,/api/ping/
# Number of trusted proxies in front of the app. Used to read the real client IP.
TRUSTED_PROXY_COUNT=1
# Random string shared with the frontend's CLIENT_IP_SHARED_SECRET so rate limits use each
# visitor's real IP. Blank disables the shared-secret path.
CLIENT_IP_SHARED_SECRET=

# ------------------------------------------
# API rate limits (per client IP)
# ------------------------------------------
# Format: <count>/<second|minute|hour|day>. Blank keeps the value shown. An invalid value is
# ignored with a warning. Raise THROTTLE_REGISTER and THROTTLE_LOGIN for events where many
# people share one network (a campus Wi-Fi appears as a single IP).
THROTTLE_ANON=100/minute
THROTTLE_USER=1000/minute
THROTTLE_LOGIN=10/minute
THROTTLE_REGISTER=10/hour
THROTTLE_FORM_SUBMIT=20/minute
THROTTLE_HACKATHON_LOOKUP=30/minute
THROTTLE_HACKATHON_EMAIL_INVITE=20/hour
THROTTLE_COLLEGE_SEARCH=120/minute

# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/srkrcc_db
# Used only by scripts/create_db.py to create the local database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=srkrcc_db
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------
# Auth
# ------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Super admin created by `manage.py setup_admin` (deployment / first boot).
# With DEBUG=False the password has no default and must be set.
DJANGO_SUPERUSER_EMAIL=srkrcodingclubofficial@gmail.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FIRST_NAME=System
DJANGO_SUPERUSER_LAST_NAME=Admin

# ------------------------------------------
# Email
# ------------------------------------------
# EMAIL_PROVIDER decides who delivers mail:
#   console  prints emails to the terminal (local development, the default when DEBUG=True)
#   resend   Resend over HTTPS (staging)  -> see .env.staging.example
#   gmail    Gmail SMTP (production)      -> see .env.production.example
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=SRKR Coding Club <noreply@srkrcc.in>
# resend only:
RESEND_API_KEY=
# gmail only (a Google app password, not the account password):
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------
# Logging and error tracking
# ------------------------------------------
LOG_LEVEL=INFO
# Sentry is switched on only when SENTRY_DSN is set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# ------------------------------------------
# File storage (optional S3 for FileField / ImageField)
# ------------------------------------------
# Leave USE_S3 false for local MEDIA_ROOT. When true, create the bucket first.
# Do not put cloud access keys here: use the platform's role or instance credentials.
# Backup intake and DMC exports still write to local paths; they are not on S3.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# ------------------------------------------
# Serverless / secret store (AWS Lambda only)
# ------------------------------------------
# When SERVERLESS=1 (or AWS_LAMBDA_FUNCTION_NAME is set) and SECRET_KEY or DATABASE_URL is
# missing, Django loads those two values from Parameter Store. Leave all of these blank
# anywhere else. Do not put secret values in this file.
SERVERLESS=
SSM_SECRET_KEY_NAME=
SSM_DATABASE_URL_NAME=
# Region for Parameter Store reads. Defaults to ap-south-1.
AWS_REGION=

# ------------------------------------------
# Container runtime (Dockerfile / docker-compose)
# ------------------------------------------
# Set to 1 to run migrate, collectstatic, seed_flags and setup_admin on container boot.
# Leave unset on serverless platforms.
RUN_STARTUP_TASKS=
PORT=8000
WEB_CONCURRENCY=1
